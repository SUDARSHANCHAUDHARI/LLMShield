{
  "name": "@stl/llmshield",
  "version": "0.1.0",
  "description": "LLMShield is a lightweight CLI toolkit for testing LLM prompts against prompt leaks, jailbreaks, and prompt injection attacks.",
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "bin": {
    "llmshield": "dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "scan:example": "tsx src/cli.ts scan --file examples/system-prompt.txt --provider mock"
  },
  "keywords": [
    "llm",
    "security",
    "prompt-injection",
    "jailbreak",
    "prompt-leak",
    "red-team"
  ],
  "author": "Sudarshan Tech Labs",
  "license": "MIT",
  "dependencies": {
    "commander": "^12.1.0",
    "dotenv": "^16.6.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
