{
  "name": "@sudarshanchaudhari/llmshield",
  "version": "0.1.0",
  "description": "LLMShield is a lightweight CLI toolkit for testing LLM prompts against prompt leaks, jailbreaks, and prompt injection attacks.",
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "bin": {
    "llmshield": "dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "rm -rf dist && tsc",
    "build:site": "pnpm build && rm -rf _site && cp -R site _site && cp -R dist _site/lib && cp docs/demo.gif _site/demo.gif",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "scan:example": "tsx src/cli.ts scan --file examples/system-prompt.txt --provider mock"
  },
  "keywords": [
    "llm",
    "security",
    "prompt-injection",
    "jailbreak",
    "prompt-leak",
    "red-team"
  ],
  "author": "Sudarshan Kishor Chaudhari (SudarshanTechLabs)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SUDARSHANCHAUDHARI/LLMShield.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "dotenv": "^16.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.8",
    "vitest": "^4.1.12"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "postcss": "8.5.33"
    }
  }
}
